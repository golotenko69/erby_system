# Скопируйте в .env и заполните значения
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=erbu.zabteh.ru,localhost
CSRF_TRUSTED_ORIGINS=https://erbu.zabteh.ru
TIME_ZONE=Asia/Chita
# Установите False, если HTTPS завершается на прокси, который не передаёт X-Forwarded-Proto
SECURE_SSL_REDIRECT=True
# Необязательно: другая БД вместо SQLite
# DATABASE_URL=postgres://user:password@host:5432/dbname
